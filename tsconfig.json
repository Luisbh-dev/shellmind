{
  // Shared compiler options and solution file. Each program has its own config:
  //   tsconfig.app.json       renderer: src/ + shared/ (bundled by Vite)
  //   tsconfig.server.json    backend: server.ts, server/, shared/ -> dist-server/
  //   tsconfig.electron.json  Electron main process -> dist-electron/
  //   tsconfig.test.json      Node-side tests and tool config files
  //   tsconfig.contract.json  contract tests: UI modules against the backend
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.server.json" },
    { "path": "./tsconfig.electron.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.contract.json" }
  ]
}
