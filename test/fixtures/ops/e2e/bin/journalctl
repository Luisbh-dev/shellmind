#!/bin/sh
# journalctl stand-in: a backlog, then (with -f) a line every 300 ms.
echo "journalctl $*" >> /tmp/ops-calls.log
echo "2024-05-06T10:00:00+0000 host nginx[100]: start request repeated too quickly"
echo "2024-05-06T10:00:01+0000 host systemd[1]: nginx.service: Failed with result 'exit-code'."
case " $* " in
    *" -f "*)
        while :; do
            echo "$(date '+%Y-%m-%dT%H:%M:%S') host app[42]: journal tick"
            sleep 0.3
        done ;;
esac
exit 0
