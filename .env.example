# ShellMind backend configuration.
#
# Copy this file to `.env` and uncomment only what you need. Every variable is
# optional: leave a line commented to keep the default. Never commit `.env`.
# The backend reads `.env` from its working directory: the project folder for
# `npm start` and `npm run serve`, the app's data folder for the desktop app.
# The desktop app (Electron) sets HOST, PORT, DB_PATH, SHELLMIND_AUTH_TOKEN,
# SHELLMIND_DATA_KEY, SHELLMIND_VERSION and SHELLMIND_ALLOW_FILE_ORIGIN (accept
# its file:// page) itself and clears ALLOWED_HOSTS, ALLOWED_ORIGINS and
# SERVE_WEB; the other settings (AI keys, logging, SSH agent) apply to it too.

# --- AI providers -------------------------------------------------------------
# A key set here takes precedence over the one saved in Settings and locks that
# field in the UI.
# GEMINI_API_KEY=
# MINIMAX_API_KEY=

# Without a MiniMax key, MiniMax requests go through the ShellMind proxy.
# MINIMAX_PROXY_URL=https://ai-proxy.luisbh.com

# Credentials for a self-hosted proxy at MINIMAX_PROXY_URL that requires them,
# sent as the x-api-key header and as `Authorization: Bearer`. The public
# ShellMind proxy needs neither.
# MINIMAX_PROXY_API_KEY=
# MINIMAX_PROXY_BEARER_TOKEN=

# With your own MiniMax key, requests go straight to MiniMax's
# Anthropic-compatible API (use https://api.minimaxi.com/anthropic in China).
# MINIMAX_API_BASE_URL=https://api.minimax.io/anthropic

# Whether a MiniMax key (from here or typed in Settings) is used at all
# (true/false, default true). When false, MiniMax always uses the proxy.
# ALLOW_CLIENT_MINIMAX_KEY=true

# --- Network ------------------------------------------------------------------
# Port and interface the backend listens on. Keep HOST on loopback unless the
# server sits behind a reverse proxy that you control.
# PORT=3001
# HOST=127.0.0.1

# Port of the Vite dev server that serves the UI under `npm start`.
# WEB_PORT=5173

# Extra browser origins allowed to call the API, comma-separated
# (for example https://shellmind.example.com). Loopback is always allowed, and
# requests from any other origin are refused with 403. The host of each origin
# listed here is also accepted in the Host header.
# ALLOWED_ORIGINS=

# Extra Host header values accepted, comma-separated: a name accepts any port
# (shellmind.example.com), name:port only that port (192.168.1.10:3001).
# Loopback names are always accepted; other Host values get a 403, which blocks
# DNS-rebinding attacks. The web UI served under such a name (`npm run serve`)
# may call the API from its own origin without listing it in ALLOWED_ORIGINS.
# ALLOWED_HOSTS=

# Serve the built web UI (dist/) from the backend itself, same origin as the
# API. `npm run serve` sets it; WEB_DIR points it at another build folder.
# SERVE_WEB=1
# WEB_DIR=

# --- Logging ------------------------------------------------------------------
# error, warn, info (default) or debug.
# LOG_LEVEL=info
# Forces debug logging, including every SSH packet and the FTP control channel
# (very verbose). Logs then contain hosts, user names and paths: do not leave
# it on.
# SHELLMIND_DEBUG=1

# --- Storage and security -----------------------------------------------------
# Location of the SQLite database (servers, identities, settings, chat
# history, audit log...). By default shellmind.db in the project folder, for
# `npm start`, `npm run serve` and the compiled backend (`node
# dist-server/server.js`) alike, never inside dist-server/, which every build
# replaces. The data key file (see SHELLMIND_DATA_KEY) is created next to it.
# DB_PATH=/var/lib/shellmind/shellmind.db

# Session token required by every API request and socket connection. When unset
# the server generates one at startup and prints it once.
# SHELLMIND_AUTH_TOKEN=

# Base64-encoded 32-byte key used to encrypt stored credentials (AES-256-GCM).
# When unset, a key file named shellmind.key is created next to the database.
# Back the key up together with the database: without it the saved
# credentials cannot be read, and the server refuses to start rather than
# silently creating a new key for a database that holds encrypted credentials.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SHELLMIND_DATA_KEY=

# Start over with a new data key when the old one is lost. The credentials
# saved with the old key are cleared and must be entered again.
# SHELLMIND_RESET_DATA_KEY=1

# --- SSH agent (identities that sign in with the agent) -----------------------
# The agent socket the backend uses, usually inherited from your session
# (ssh-agent, gpg-agent, 1Password, Bitwarden...). On Windows, without it, the
# OpenSSH agent pipe (\\.\pipe\openssh-ssh-agent) and then Pageant are used.
# SSH_AUTH_SOCK=
# Overrides that lookup: a socket or Windows pipe path, "pageant", or "off".
# When HOST is not a loopback address the agent of the backend's machine is
# only used when this names it.
# SHELLMIND_SSH_AGENT=

# --- Windows servers -----------------------------------------------------------
# How the PowerShell scripts of the status, services, logs, fleet, patch, disk
# and diagnosis panels reach a Windows server over SSH. By default the script
# is written to the stdin of `powershell -NoProfile -NonInteractive -Command -`
# (a short, fixed command line). "encoded" sends it as -EncodedCommand on the
# command line instead: only for an SSH server that does not pass stdin on,
# since endpoint protection tends to flag long encoded command lines.
# SHELLMIND_POWERSHELL_DELIVERY=encoded

# --- Web frontend (read by Vite at build time) --------------------------------
# Backend origin the web UI calls when it is neither the origin that served the
# page (`npm run serve`) nor the local http://127.0.0.1:3001 (for example when
# the API sits behind its own reverse proxy). Also added to the UI's
# Content-Security-Policy.
# VITE_API_BASE=
